# ============================================================
# Environment variables for the AI YouTube & Website Summarizer
# Copy this file to .env and fill in real values.
# NEVER commit the .env file itself — only this .example version.
# ============================================================

# ---- Required: Groq API ----
# Get a key at https://console.groq.com
GROQ_API_KEY=your_groq_api_key_here

# ---- Optional: override the default Groq model ----
# Defaults to openai/gpt-oss-120b in config.py if not set.
# Useful if Groq deprecates a model and you need to swap without touching code.
GROQ_MODEL_NAME=openai/gpt-oss-120b

# ---- Optional: logging verbosity ----
# One of: DEBUG, INFO, WARNING, ERROR
LOG_LEVEL=INFO

# ---- Optional: only needed if the HuggingFace embedding component is switched
# from a local sentence-transformers model to the Hosted Inference API.
# Not required for the default local-model setup.
# HUGGINGFACEHUB_API_TOKEN=your_huggingface_token_here